<?xml version="1.0" encoding="utf-8"?>
<!--
  Ikon splash Android 12+ yang sengaja KOSONG (transparan).

  Di Android 12+ sistem menampilkan "splash screen" bawaan selama proses
  aplikasi dinyalakan, dan ikonnya diambil dari atribut
  `android:windowSplashScreenAnimatedIcon`. Kalau atribut itu tidak diisi, sistem
  memakai `android:icon` aplikasi, yaitu `@mipmap/ic_launcher` yang sampai
  sekarang masih logo Flutter bawaan. Itulah logo biru yang terlihat sesaat
  sebelum splash Agronoma muncul.

  Dengan mengarahkan atribut itu ke drawable transparan ini, tidak ada apa pun
  yang digambar sehingga tampilannya langsung putih polos (warna splash sendiri
  diatur lewat `android:windowSplashScreenBackground`), lalu langsung menyambung
  ke splash Flutter.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#00000000" />
</shape>
